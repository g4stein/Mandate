# Mandate API & PayPal Configuration
PORT=3000

# PayPal Sandbox Credentials
# Replace with your actual credentials from developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=mock_client_id_sandbox
PAYPAL_CLIENT_SECRET=mock_client_secret_sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Firewall Defaults
AUTO_APPROVE_MAX=50.00
HARD_CAP_MAX=200.00
DEFAULT_CURRENCY=USD
